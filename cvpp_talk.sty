% 中文研究汇报的本地 Beamer 样式。
% 使用方式：\documentclass[aspectratio=169,11pt,fontset=ubuntu]{ctexbeamer}
%           \usepackage{cvpp_talk}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvpp_talk}[2026/11/11 Chinese research talk style]

% 与现有汇报一致：metropolis + Fira Sans + Noto Sans CJK（ubuntu fontset）。
\usetheme[progressbar=frametitle,sectionpage=none]{metropolis}
\RequirePackage[sfdefault,lining]{FiraSans}
\RequirePackage[italic]{mathastext}
\renewcommand*{\CJKrmdefault}{zhhei}
\renewcommand*{\CJKfamilydefault}{zhhei}

\RequirePackage{amsmath}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{graphicx}

% 主色只承担强调；需要区分三个数据系列时再使用后三种颜色。
\definecolor{Ink}{HTML}{0B0B0B}
\definecolor{Muted}{HTML}{626262}
\definecolor{Surface}{HTML}{FCFCFB}
\definecolor{Accent}{HTML}{2A78D6}
\definecolor{Warm}{HTML}{EB6834}
\definecolor{SeriesA}{HTML}{2A78D6}
\definecolor{SeriesB}{HTML}{EB6834}
\definecolor{SeriesC}{HTML}{1BAF7A}

\setbeamercolor{normal text}{fg=Ink,bg=Surface}
\setbeamercolor{frametitle}{fg=Ink,bg=Surface}
\setbeamercolor{title}{fg=Ink}
\setbeamercolor{subtitle}{fg=Muted}
\setbeamercolor{progress bar}{fg=Accent}
\setbeamercolor{title separator}{fg=Accent}
\setbeamercolor{footline}{fg=Muted}
\setbeamercolor{alerted text}{fg=Warm}
\setbeamercolor{block title}{fg=Accent,bg=Surface}
\setbeamercolor{block body}{fg=Ink,bg=Accent!4}

\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small}
\setbeamerfont{footline}{size=\tiny}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\textcolor{Accent}{--}}
\setbeamertemplate{itemize subitem}{\textcolor{Muted}{--}}
\setbeamertemplate{caption}[numbered]
\setlength{\leftmargini}{1.2em}
\setlength{\leftmarginii}{1.1em}

% 图前的一句话只解释读法或页面任务，不重复标题中的结论。
\newcommand{\lead}[1]{{\small #1\par}\vspace{.45em}}

% 来源、分母和估计边界；只保留理解本页所必需的一行。
\newcommand{\source}[1]{\par\vspace{.2em}{\tiny\color{Muted}#1\par}}

% 图后的唯一结论。避免在同页重复放置多个 takeaway。
\newcommand{\takeaway}[1]{%
  \par\vspace{.45em}%
  {\color{Accent}\rule[-.18em]{2pt}{1.15em}}%
  \hspace{.45em}{\large #1}\par%
}

% 三个以内的关键数字；第二个参数是短标签。
\newcommand{\bignumber}[2]{%
  {\color{Accent}\fontsize{25}{28}\selectfont #1}\par
  \vspace{.15em}{\small\color{Muted}#2}\par%
}

% 流程图中的统一卡片。第一个参数是层级标签，第二个参数是主体。
\newcommand{\flowbox}[2]{%
  \fcolorbox{Accent!25}{Accent!5}{%
    \begin{minipage}[c][2.8cm][c]{.82\linewidth}
      \centering
      {\small\color{Muted}#1}\par
      \vspace{.45em}
      {\large #2}\par
    \end{minipage}}%
}

% 章节页不堆目录；只交代接下来回答什么。
\newcommand{\sectionslide}[3]{%
  \begin{frame}[plain]
    \vfill
    {\small\color{Accent}#1}\par
    \vspace{.5em}
    {\LARGE\bfseries #2}\par
    \vspace{.7em}
    {\large\color{Muted}#3}\par
    \vfill
  \end{frame}%
}

% 数据图图注：固定写在图下，明确横轴、纵轴和其他视觉编码。
% 示意图没有坐标轴时，不使用本命令，改写一句箭头/颜色含义。
\newcommand{\figurecaption}[3]{%
  \par\vspace{.15em}%
  {\footnotesize\color{Muted}\textbf{图注}\quad 横轴：#1；纵轴：#2；#3\par}%
}

% 固定封面。标题元数据仍在 main/template 顶部统一填写。
\newcommand{\coverslide}[1]{%
  \begin{frame}[plain]
    \vspace{2.2em}
    {\LARGE\bfseries\inserttitle}\par
    \vspace{.65em}
    {\large\color{Muted}\insertsubtitle}\par
    \vspace{1.2em}
    {\color{Accent}\rule{.78\linewidth}{.6pt}}\par
    \vspace{2em}
    {\small\insertauthor}\par
    \vspace{.2em}
    {\small\insertdate}\par
    \vspace{.7em}
    {\footnotesize\color{Muted}#1}\par
    \vfill
  \end{frame}%
}

% 固定目录：只列三个研究问题，不使用章节名堆砌的传统目录。
\newcommand{\agendaslide}[3]{%
  \begin{frame}{本次汇报回答三个问题}
    \vspace{1.4em}
    \begin{columns}[T,onlytextwidth]
      \column{.30\textwidth}\bignumber{01}{#1}
      \column{.30\textwidth}\bignumber{02}{#2}
      \column{.30\textwidth}\bignumber{03}{#3}
    \end{columns}
    \vfill
    \centering{\color{Muted}任务与数据 $\rightarrow$ 方法 $\rightarrow$ 结果 $\rightarrow$ 边界}
  \end{frame}%
}

% 固定全宽结果页：结论标题 → 主图 → 坐标图注 → take-home → 来源。
% 参数：标题、图路径、横轴、纵轴、点线颜色含义、take-home、来源。
\newcommand{\fullfigureslide}[7]{%
  \begin{frame}{#1}
    \vspace{0pt}
    \centering
    \includegraphics[width=.90\textwidth,height=.48\textheight,keepaspectratio]{#2}\par
    \figurecaption{#3}{#4}{#5}
    \takeaway{#6}
    \source{#7}
  \end{frame}%
}

% 固定三点页：用于边界或最终结论，不额外添加第四点。
% 参数：页标题、三个小标题及其正文。
\newcommand{\threepointslide}[7]{%
  \begin{frame}{#1}
    \vspace{.5em}
    {\large\color{Accent}1\hspace{.5em}#2}\par
    {\large #3}\par
    \vspace{.8em}
    {\large\color{Accent}2\hspace{.5em}#4}\par
    {\large #5}\par
    \vspace{.8em}
    {\large\color{Accent}3\hspace{.5em}#6}\par
    {\large #7}\par
  \end{frame}%
}

% 结尾保留研究结论，而不是只写“谢谢”。
\newcommand{\closingslide}[2]{%
  \begin{frame}[plain]
    \vfill
    \centering
    {\LARGE\bfseries #1}\par
    \vspace{1em}
    {\large\color{Muted}#2}\par
    \vfill
  \end{frame}%
}
